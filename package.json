{
  "name": "tau",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "oxlint packages scripts && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "eval": "bun run packages/app/src/main.ts eval",
    "dev": "bun run --cwd packages/app src/cli.ts",
    "build": "bun build --compile --minify --sourcemap packages/app/src/main.ts --outfile dist/tau",
    "build:all": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.22",
    "@types/bun": "1.3.13",
    "oxlint": "1.77.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
